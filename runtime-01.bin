<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#eff3e8" />
    <title>천년가족 · 브라우저 에디션</title>
    <style>
:root {
  --ink: #223d49;
  --muted: #708087;
  --cream: #f9f7ef;
  --paper: #fffcf5;
  --teal: #246b6f;
  --orange: #dc825c;
  --pink: #d36e80;
  --line: #dbdfd6;
  --button-ivory: #fff6d9;
  --button-gold: #efda92;
  --button-jade: #dcebd7;
  --button-blue: #c7e2ee;
  --button-edge: #827344;
  --button-ink: #3e422d;
  --radius: 20px;
  font-family:
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Apple SD Gothic Neo",
    "Malgun Gothic",
    sans-serif;
  color: var(--ink);
  background: #e9eee5;
  font-synthesis: none;
}
* {
  box-sizing: border-box;
}
html,
body {
  margin: 0;
  min-height: 100%;
  overscroll-behavior-y: none;
}
body {
  background:
    radial-gradient(ellipse at 30% 5%, #fffaf0 0, transparent 60%), #e9eee5;
}
button,
input,
select {
  font: inherit;
}
button {
  cursor: pointer;
  touch-action: manipulation;
}
button:disabled {
  cursor: default;
}
button:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 3px solid #3c687e;
  outline-offset: 3px;
}
button {
  border: 0;
}
.app {
  width: 100%;
  max-width: 480px;
  min-height: 100dvh;
  margin: auto;
  background: var(--cream);
  box-shadow: 0 0 70px #2b3b3c12;
  position: relative;
  padding: env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
}
.boot {
  text-align: center;
  padding: 30vh 22px;
}
.boot-star {
  color: var(--orange);
  font-size: 48px;
}
.boot h1 {
  letter-spacing: -2px;
  font-size: 40px;
}
.boot p {
  color: var(--muted);
}
.overline {
  text-transform: uppercase;
  letter-spacing: 2.5px;
  font-size: 10px;
  font-weight: 750;
  color: var(--teal);
  margin: 0 0 14px;
}
.title-screen {
  --title-art-width-cap: 480px;
  --title-height: calc(100dvh - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  --title-column-width: min(100vw, var(--title-art-width-cap));
  --title-inline-padding: clamp(12px, calc(var(--title-column-width) * .045), 22px);
  --title-padding-top: clamp(8px, 2dvh, 22px);
  --title-padding-bottom: clamp(8px, 1.8dvh, 20px);
  --title-gap: clamp(6px, 1.2dvh, 12px);
  --title-action-gap: clamp(6px, 1.15dvh, 12px);
  --title-heading-size: clamp(27px, min(calc(var(--title-column-width) * .105), 5.7dvh), 46px);
  --title-overline-size: clamp(8px, min(calc(var(--title-column-width) * .025), 1.5dvh), 12px);
  --title-subtitle-size: clamp(9px, min(calc(var(--title-column-width) * .03), 1.7dvh), 13px);
  --title-heading-gap: clamp(3px, .7dvh, 6px);
  --title-subtitle-gap: clamp(3px, .6dvh, 5px);
  --title-header-height: calc(var(--title-overline-size) * 1.2 + var(--title-heading-size) * 1.05 + var(--title-heading-gap) * 2 + var(--title-subtitle-size) * 2.8 + var(--title-subtitle-gap));
  --title-actions-min-height: calc(128px + var(--title-action-gap) * 3);
  /* Reserve the real header and all four touch targets before sizing the art.
   * Short windows shrink the whole original 3:2 plate, never crop or stretch it. */
  --title-art-height-budget: calc(var(--title-height) - var(--title-padding-top) - var(--title-padding-bottom) - var(--title-gap) * 2 - var(--title-header-height) - var(--title-actions-min-height));
  height: var(--title-height);
  min-height: 0;
  padding: var(--title-padding-top) var(--title-inline-padding) var(--title-padding-bottom);
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: minmax(max-content, .45fr) max-content minmax(var(--title-actions-min-height), 1fr);
  justify-items: center;
  gap: var(--title-gap);
}
.app:has(> .title-screen) { margin: 0 auto; min-height: 100dvh; border-radius: 0; }
.title-top {
  align-self: stretch;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
  margin: 0;
}
.title-top .overline { margin: 0; font-size: var(--title-overline-size); line-height: 1.2; letter-spacing: .18em; }
.title-top h1 {
  font-size: var(--title-heading-size);
  line-height: 1.05;
  font-weight: 850;
  letter-spacing: -2px;
  margin: var(--title-heading-gap) 0;
  color: #cb6578;
  text-shadow:
    2px 3px 0 #f9f7ef,
    3px 4px 0 #91b6b9;
}
.subtitle {
  font-size: 13px;
  line-height: 1.8;
  color: var(--muted);
  margin: 13px 0;
}
.title-top .subtitle { font-size: var(--title-subtitle-size); line-height: 1.4; margin: var(--title-subtitle-gap) 0 0; }
.title-art-wrap {
  width: min(calc(100% + var(--title-inline-padding) * 2), var(--title-art-width-cap), max(0px, calc(var(--title-art-height-budget) * 1.5)));
  height: auto;
  aspect-ratio: 3 / 2;
  align-self: center;
  position: relative;
  border: 0;
  background: #e7e8bb;
  min-height: 0;
}
.title-art {
  width: 100%;
  height: 100%;
  display: block;
  image-rendering: pixelated;
}
.art-caption {
  font-size: 11px;
  position: absolute;
  bottom: 12px;
  left: 16px;
  color: #304442;
  background: #ffffffe3;
  padding: 6px 10px;
  border-radius: 20px;
}
.title-actions {
  width: 100%;
  height: 100%;
  min-height: 0;
  align-self: stretch;
  display: grid;
  grid-template-rows: repeat(4, minmax(32px, 1fr));
  gap: var(--title-action-gap);
  margin: 0;
}
.title-actions > * { min-width: 0; }
.title-actions > .button-row { min-height: 0; align-items: stretch; }
.title-actions .btn {
  height: 100%;
  min-height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: clamp(4px, 1dvh, 10px) 10px;
  border-radius: clamp(8px, 1.4dvh, 13px);
  font-size: clamp(12px, min(calc(var(--title-column-width) * .038), 2.2dvh), 18px);
  line-height: 1.2;
}
.title-screen > .footnote { font-size: 9px; line-height: 1.4; margin: 0; }
@media (min-width: 700px) and (hover: hover) and (pointer: fine) {
  .title-screen { --title-art-width-cap: 390px; }
}
.btn {
  min-height: 46px;
  padding: 12px 16px;
  border-radius: 13px;
  --button-fill: var(--button-jade);
  --button-stroke: #567357;
  --button-text: #294638;
  font-weight: 700;
  transition:
    background-color 0.1s,
    box-shadow 0.1s;
}
.btn.orange {
  --button-fill: var(--button-gold);
  --button-stroke: #887033;
  --button-text: #493a1d;
}
.btn.secondary {
  --button-fill: var(--button-ivory);
  --button-stroke: var(--button-edge);
  --button-text: var(--button-ink);
}
.btn.ghost {
  --button-fill: #f4f0e4;
  --button-stroke: #8b8e7d;
  --button-text: #505b4d;
}
.btn.small {
  font-size: 12px;
  min-height: 35px;
  padding: 8px 11px;
  border-radius: 10px;
}
.button-row {
  display: flex;
  gap: 8px;
}
.button-row > * {
  flex: 1;
}
.footnote {
  font-size: 10px;
  line-height: 1.7;
  color: #839087;
  text-align: center;
  margin-top: 24px;
}
.game-header {
  padding: 21px 20px 15px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}
.game-header h1 {
  font-size: 24px;
  letter-spacing: -1px;
  margin: 3px 0 0;
}
.game-header .overline {
  margin: 0;
  font-size: 9px;
  letter-spacing: 1.7px;
}
.icon-button {
  height: 38px;
  min-width: 38px;
  border-radius: 13px;
  --button-fill: var(--button-jade);
  --button-stroke: #567357;
  --button-text: #294638;
  font-size: 20px;
}
.hud {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 0 20px 17px;
  font-size: 12px;
}
.hud-date {
  font-weight: 700;
}
.hud-money {
  margin-left: auto;
  color: var(--muted);
}
.hud-money strong {
  color: var(--ink);
}
.scene-shell {
  position: relative;
  background: #eee4bc;
  border-top: 1px solid #d4d8be;
  border-bottom: 1px solid #d4d8be;
  overflow: hidden;
  --pixel-scale: 1;
}
.scene-dialog {
  position: absolute;
  z-index: 4;
  left: .833333%;
  right: .833333%;
  bottom: 1.5%;
  display: flex;
  justify-content: center;
  pointer-events: none;
}
.dialogue-frame {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 100%;
  border: 0;
  border-radius: 0;
  background: transparent;
  padding: calc(15px * var(--pixel-scale)) calc(20px * var(--pixel-scale)) calc(10px * var(--pixel-scale)) calc(10px * var(--pixel-scale));
  text-align: left;
  font: inherit;
  font-size: calc(10.5px * var(--pixel-scale));
  color: #23424b;
  cursor: pointer;
  pointer-events: auto;
}
.dialogue-frame.short-dialogue { min-height: calc(54px * var(--pixel-scale)); }
.dialogue-frame .dialog-copy { display: block; width: 100%; transform: translateY(var(--dialog-copy-offset, 0px)); }
.bubble-art {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  image-rendering: pixelated;
  pointer-events: none;
}
.dialogue-frame > span { position: relative; }
.dialogue-frame .dialog-speaker {
  display: block;
  font-size: calc(8px * var(--pixel-scale));
  margin: 0 0 calc(2px * var(--pixel-scale));
}
.dialogue-frame .dialog-text {
  display: block;
  font-size: inherit;
  line-height: 1.2;
  min-height: 0;
  max-height: calc(64px * var(--pixel-scale));
  overflow-y: auto;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.dialogue-frame .dialog-next {
  position: absolute;
  right: calc(7px * var(--pixel-scale));
  /* Original bubble's rectangular panel starts 11 logical pixels below its tail. */
  top: calc(50% + 5.5px * var(--pixel-scale));
  transform: translateY(-50%);
  font-size: calc(7px * var(--pixel-scale));
  line-height: 1;
  color: #416772;
  pointer-events: none;
}
.dialogue-frame .dialog-actions {
  display: flex;
  flex-wrap: wrap;
  gap: calc(4px * var(--pixel-scale));
  margin-top: calc(4px * var(--pixel-scale));
}
.dialogue-frame .dialog-actions .btn {
  flex: 1;
  min-width: 42%;
  padding: calc(5px * var(--pixel-scale));
  min-height: 32px;
  font-size: calc(9px * var(--pixel-scale));
  border-radius: calc(5px * var(--pixel-scale));
  text-align: center;
}
.scene-tip {
  position: absolute;
  left: calc(42px * var(--pixel-scale));
  top: calc(8px * var(--pixel-scale));
  width: max-content;
  max-width: calc(100% - 52px * var(--pixel-scale));
  min-width: calc(22px * var(--pixel-scale));
  padding: calc(5px * var(--pixel-scale)) calc(8px * var(--pixel-scale)) calc(9px * var(--pixel-scale));
  font-size: calc(9px * var(--pixel-scale));
  line-height: 1.25;
  color: #23424b;
  pointer-events: none;
}
.scene-tip[hidden], .scene-note[hidden], .cupid-tip-trigger[hidden] { display: none; }
.scene-tip canvas { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; }
.scene-tip span {
  position: relative;
  display: block;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  text-align: left;
}
.scene-tip.single-line span { text-align: center; }
.family-chatter {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
}
.family-chatter[hidden] { display: none; }
.family-chatter-bubble {
  position: absolute;
  width: calc(32px * var(--pixel-scale));
  height: calc(32px * var(--pixel-scale));
  padding: 0;
  border: 0;
  background: transparent;
  image-rendering: pixelated;
  pointer-events: none;
}
.family-chatter-bubble[hidden] { display: none; }
.cupid-tip-trigger {
  position: absolute;
  left: 0;
  top: calc(20px * var(--pixel-scale));
  width: calc(44px * var(--pixel-scale));
  height: calc(44px * var(--pixel-scale));
  border: 0;
  padding: 0;
  background: transparent;
  border-radius: 50%;
  cursor: pointer;
  touch-action: none;
}
.cupid-tip-trigger:focus-visible { outline: 2px solid #416772; outline-offset: -2px; }
.intro-screen { padding: 18px 0; }
.intro-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 18px 14px;
  color: #416772;
  font-size: 12px;
}
.intro-cancel { border: 0; border-radius: 7px; padding: 8px; }
.day-line.intro-playback { justify-content: space-between; padding: 10px 12px; gap: 8px; }
.intro-playback button { min-height: 36px; white-space: nowrap; }
.intro-playback-buttons { display: flex; align-items: center; gap: 8px; margin-left: auto; }
.intro-name-form { display: grid; gap: 12px; padding: 18px; }
.house-canvas {
  display: block;
  width: 100%;
  height: auto;
  image-rendering: pixelated;
  touch-action: none;
  cursor: grab;
}
.house-canvas:active {
  cursor: grabbing;
}
.event-scene-title {
  position: absolute;
  left: 8.333333%;
  width: 83.333333%;
  height: 16.666667%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #23424b;
  font-family: inherit;
  font-weight: 800;
  font-synthesis: weight;
  -webkit-text-stroke: .02em currentColor;
  line-height: 1.2;
  pointer-events: none;
}
.event-scene-title[hidden] {
  display: none;
}
.event-scene-title > span {
  flex: none;
  white-space: nowrap;
  transform-origin: center;
}
.scene-note {
  position: absolute;
  top: 12px;
  left: 12px;
  background: #fffff2e8;
  border: 1px solid #fafcf0aa;
  backdrop-filter: blur(4px);
  padding: 6px 10px;
  border-radius: 20px;
  font-size: 10px;
  color: #637369;
  pointer-events: none;
}
.scene-hud {
  position: absolute;
  top: 12px;
  right: 12px;
  display: grid;
  justify-items: end;
  gap: 4px;
  max-width: calc(100% - 24px);
  pointer-events: none;
}
.scene-hud[hidden] { display: none; }
.scene-time {
  display: flex;
  gap: 5px;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.2;
  background: #213d49b3;
  color: white;
  padding: 6px 10px;
  border-radius: 20px;
}
.scene-time[hidden] { display: none; }
.scene-mood {
  padding: 6px 10px;
  border-radius: 20px;
  background: #213d49b3;
  color: white;
  font-size: 12px;
  font-weight: 750;
  line-height: 1.25;
  white-space: nowrap;
}
.scene-mood-state { -webkit-text-stroke: .75px #172b36; paint-order: stroke fill; }
.scene-bottom {
  position: absolute;
  bottom: 10px;
  right: 12px;
}
.follow-btn {
  padding: 7px 10px;
  border-radius: 20px;
  font-size: 10px;
}
.day-line {
  padding: 15px 18px 12px;
  display: flex;
  gap: 8px;
  align-items: center;
}
.day-line .speed-label {
  font-size: 11px;
  color: var(--muted);
  flex: 1;
}
.fast-btn {
  padding: 9px;
  border: 1px solid var(--button-edge);
  border-radius: 12px;
  font-size: 11px;
  touch-action: manipulation;
}
.member-panel {
  margin: 0 16px 14px;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 15px;
}
.member-nav {
  display: flex;
  align-items: center;
  gap: 10px;
}
.nav-arrow {
  width: 28px;
  height: 35px;
  border-radius: 6px;
  font-size: 18px;
  padding: 0;
}
.portrait {
  width: 52px;
  height: 70px;
  flex: none;
  image-rendering: pixelated;
  object-fit: contain;
  background: #eef2e9;
  border-radius: 12px;
}
.member-id {
  flex: 1;
  min-width: 0;
}
.member-name {
  display: flex;
  gap: 6px;
  align-items: center;
  font-size: 19px;
  font-weight: 750;
  letter-spacing: -0.5px;
}
.member-age {
  font-weight: 500;
  font-size: 11px;
  color: var(--muted);
}
.member-job {
  font-size: 11px;
  color: var(--muted);
  margin-top: 4px;
}
.head-tag {
  font-size: 9px;
  background: #f8e9ba;
  padding: 3px 5px;
  border-radius: 5px;
  color: #9a7935;
}
.heir-tag {
  display: inline-block;
  margin-left: 3px;
  padding: 3px 5px;
  border-radius: 5px;
  background: #deecfa;
  color: #315f7a;
  font-size: 10px;
  font-weight: 750;
  line-height: 1.15;
  vertical-align: middle;
}
.member-hearts {
  display: flex;
  gap: 1px;
  margin-top: 7px;
}
.heart {
  width: 15px;
  height: 15px;
  image-rendering: pixelated;
  object-fit: contain;
}
.heart-fallback {
  font-size: 14px;
  color: #d96e87;
}
.member-more {
  border-radius: 6px;
  font-size: 11px;
  padding: 6px;
}
.activity {
  padding: 11px 0 2px;
  display: flex;
  gap: 8px;
  font-size: 12px;
  align-items: flex-start;
}
.activity .label {
  font-size: 10px;
  border-radius: 5px;
  background: #eaf0e9;
  color: var(--teal);
  padding: 3px 5px;
  flex-shrink: 0;
}
.activity-text {
  line-height: 1.5;
  flex: 1;
  font-weight: 800;
  font-synthesis: weight;
}
.gauge-wrap {
  margin-top: 11px;
}
.interest-description {
  margin: 6px 0 0;
  padding: 7px 8px;
  background: #eef3e9;
  border-radius: 7px;
  font-size: 14px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.interest-description p { margin: 0; }
.interest-description-hint { padding-top: 3px; color: #426c35; font-weight: 650; }
.name-edit { min-height: 28px; padding: 3px 5px; border-radius: 6px; font-size: 10px; line-height: 1.2; font-weight: 600; letter-spacing: 0; flex: none; }
.gauge-label {
  display: flex;
  justify-content: space-between;
  color: #88918b;
  font-size: 10px;
  margin-bottom: 6px;
}
.gauge {
  height: 5px;
  background: #e6e9df;
  border-radius: 5px;
  overflow: hidden;
}
.gauge-fill {
  height: 100%;
  background: #cfb168;
  transition: width 0.3s;
}
.game-tools {
  display: flex;
  gap: 7px;
  padding: 0 16px 16px;
}
.tool-button {
  flex: 1 1 0;
  min-width: 0;
  padding: 6px 2px;
  border: 0;
  --button-fill: var(--button-jade);
  --button-stroke: #567357;
  --button-text: #294638;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60px;
  border-radius: 13px;
  font-size: 10px;
  gap: 4px;
}
.tool-button .tool-icon {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  flex: 0 0 32px;
  font-size: 20px;
  line-height: 1;
}
.tool-button img {
  height: 24px;
  width: 25px;
  image-rendering: pixelated;
  object-fit: contain;
}
.tool-button .menu-tool-icon {
  display: block;
  width: 32px;
  height: 32px;
  aspect-ratio: 1;
  flex: none;
  image-rendering: auto;
}
.tool-button.orange {
  --button-fill: var(--button-gold);
  --button-stroke: #887033;
  --button-text: #493a1d;
}
.game-footer {
  border-top: 1px solid #e7e8de;
  padding: 14px 19px;
  color: #8a958d;
  font-size: 10px;
  display: flex;
  justify-content: space-between;
}
.modal-overlay {
  position: fixed;
  inset: 0;
  background: #213b4980;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
  backdrop-filter: blur(4px);
}
.modal {
  width: 100%;
  max-width: 440px;
  max-height: 88dvh;
  background: var(--cream);
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 25px 70px #13313933;
  display: flex;
  flex-direction: column;
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 19px 20px 15px;
  gap: 12px;
  border-bottom: 1px solid var(--line);
}
.modal-header h2 {
  font-size: 19px;
  margin: 0;
  letter-spacing: -0.5px;
}
.close-button {
  border-radius: 50%;
  width: 30px;
  height: 30px;
  font-size: 18px;
}
.modal-body {
  padding: 20px;
  overflow-y: auto;
  overscroll-behavior: contain;
}
.modal-body p {
  font-size: 13px;
  line-height: 1.8;
}
.form-label {
  display: block;
  font-size: 11px;
  color: var(--muted);
  font-weight: 650;
  margin: 17px 0 7px;
}
.form-label:first-child {
  margin-top: 0;
}
.input {
  width: 100%;
  padding: 13px 12px;
  min-height: 46px;
  border-radius: 12px;
  border: 1px solid #d6ddd2;
  background: white;
  color: var(--ink);
}
.form-help {
  font-size: 11px !important;
  color: var(--muted);
}
.form-actions {
  margin-top: 23px;
  display: grid;
  gap: 9px;
}
.detail-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}
.detail-profile {
  min-width: 0;
  display: grid;
  grid-template-columns: 56px minmax(0, 1fr);
  align-items: center;
  gap: 8px;
}
.detail-hero .portrait {
  width: 56px;
  height: 72px;
  object-fit: contain;
  object-position: center;
}
.detail-hero .portrait[data-sex="male"] { background: #e1f2ff; }
.detail-hero .portrait[data-sex="female"] { background: #ffe8ef; }
.detail-identity { min-width: 0; }
.detail-identity p { margin: 3px 0; font-size: 12px; line-height: 1.35; overflow-wrap: anywhere; }
.detail-name {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 3px 5px;
  font-size: 22px;
  line-height: 1.15;
  font-weight: 750;
  margin-bottom: 2px;
  overflow-wrap: anywhere;
}
.detail-name > span { min-width: 0; max-width: 100%; }
.detail-stats {
  min-width: 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 4px;
  margin: 0;
}
.detail-stats .stat { min-width: 0; padding: 9px 1px; border-radius: 8px; }
.detail-stats .stat label { font-size: 11px; font-weight: 650; line-height: 1.1; white-space: nowrap; }
.detail-stats .stat strong { font-size: clamp(17px, 6vw, 24px); font-weight: 850; line-height: 1.1; letter-spacing: -0.04em; margin-top: 5px; white-space: nowrap; }
.detail-stats .stat small { display: none; }
.detail-stats .stat[data-grade^="S"] { background: #fff0c7; border-color: #d2aa59; }
.detail-stats .stat[data-grade^="S"] strong { color: #9a6000; }
.detail-stats .stat[data-grade="A"] { background: #fbe3dc; }
.detail-stats .stat[data-grade="A"] strong { color: #bb4139; }
.detail-stats .stat[data-grade="B"] { background: #f0e2f9; }
.detail-stats .stat[data-grade="B"] strong { color: #80509e; }
.detail-stats .stat[data-grade="C"] { background: #e0effb; }
.detail-stats .stat[data-grade="C"] strong { color: #2567a7; }
.detail-stats .stat[data-grade="D"] { background: #e4f2eb; }
.detail-stats .stat[data-grade="D"] strong { color: #37725f; }
.detail-stats .stat[data-grade="E"] { background: #f3eddf; }
.detail-stats .stat[data-grade="E"] strong { color: #77654c; }
.detail-stats .stat[data-grade="F"] { background: #ecf0f4; }
.detail-stats .stat[data-grade="F"] strong { color: #687582; }
.detail-sex-line { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; }
.detail-sex-line .detail-hearts { display: inline-flex; gap: 2px; margin: 0; align-items: center; }
.detail-sex-line .heart { width: 19px; height: 19px; }
.detail-sex-line .heart-fallback { font-size: 19px; line-height: 1; }
@media (max-width: 340px) {
  .modal-body:has(> .detail-hero) { padding-inline: 12px; }
  .detail-hero { gap: 8px; }
  .detail-profile { grid-template-columns: 44px minmax(0, 1fr); gap: 6px; }
  .detail-hero .portrait { width: 44px; height: 64px; }
  .detail-name { font-size: 18px; line-height: 1.15; }
  .detail-identity p { font-size: 11px; line-height: 1.2; }
  .detail-sex-line .heart { width: 17px; height: 17px; }
  .detail-sex-line .heart-fallback { font-size: 17px; }
  .detail-stats { gap: 3px; }
  .detail-stats .stat { padding: 8px 0; border-radius: 6px; }
  .detail-stats .stat label { font-size: 10px; }
}
.stat {
  padding: 12px 3px;
  background: #fffdf6;
  border: 1px solid #e1e3d6;
  border-radius: 12px;
  text-align: center;
}
.stat label {
  display: block;
  font-size: 10px;
  color: var(--muted);
}
.stat strong {
  display: block;
  font-size: 22px;
  color: #bd8c42;
  margin-top: 5px;
}
.stat small {
  font-size: 9px;
  color: var(--muted);
}
.info-line {
  display: flex;
  gap: 10px;
  font-size: 12px;
  padding: 10px 0;
  border-top: 1px solid #e6e8df;
}
.info-line label {
  flex: none;
  width: 65px;
  color: var(--muted);
}
.info-line span {
  white-space: pre-wrap;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.tree-card {
  padding: 12px;
  border: 1px solid var(--button-edge);
  border-radius: 13px;
  margin: 8px 0;
  display: flex;
  gap: 11px;
  align-items: center;
}
.tree-card .portrait {
  width: 56px;
  height: 70px;
  object-fit: cover;
  object-position: top center;
}
.tree-card .portrait[data-sex="male"] { background: #e1f2ff; }
.tree-card .portrait[data-sex="female"] { background: #ffe8ef; }
.tree-card > div { min-width: 0; }
.tree-card strong {
  font-size: 13px;
}
.tree-card p {
  font-size: 11px;
  line-height: 1.4;
  margin: 4px 0;
  color: var(--muted);
}
.tree-meta {
  font-size: 10px;
  color: var(--muted);
}
.log-entry {
  padding: 12px 0;
  border-bottom: 1px solid #dfe4d8;
  font-size: 12px;
  line-height: 1.6;
}
.journal-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  padding-block: 10px;
}
.journal-row-copy { min-width: 0; overflow-wrap: anywhere; }
.journal-row-copy .form-help { margin: 0 0 3px; line-height: 1.5; }
.journal-row-replay.btn.small {
  min-width: 70px;
  min-height: 44px;
  padding: 6px 9px;
  border-radius: 8px;
  white-space: nowrap;
}
.offline-history-intro { font-size: 13px; line-height: 1.65; }
.offline-history-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px;
  align-items: center;
  margin-block: 8px;
  padding: 10px;
  border: 1px solid #dce5d6;
  border-radius: 9px;
  background: #f5f8f1;
}
.offline-history-row.is-important { background: #fff2ce; border-color: #b78335; }
.offline-history-row > div { min-width: 0; overflow-wrap: anywhere; }
.offline-history-row strong { display: block; font-size: 13px; line-height: 1.55; }
.offline-history-date { margin: 0 0 4px; font-size: 10px; color: #647468; line-height: 1.5; }
.offline-history-badges { display: flex; flex-wrap: wrap; gap: 5px; margin: 5px 0 0; font-size: 10px; color: #66756a; }
.offline-important-badge { border-radius: 4px; padding: 1px 5px; background: #8d5817; color: #fff; font-weight: 800; }
.offline-history-row .btn { min-height: 44px; padding: 7px; font-size: 10px; white-space: nowrap; }
.exit-tool { --button-fill: #e8e2d2; --button-stroke: #807054; --button-text: #564629; }
.empty {
  text-align: center;
  padding: 25px 0;
  color: var(--muted);
  font-size: 13px;
}
.setting-row {
  display: flex;
  gap: 12px;
  align-items: center;
  justify-content: space-between;
  font-size: 13px;
  padding: 13px 0;
  border-bottom: 1px solid #e0e4d7;
}
.setting-row label {
  flex: 1;
}
.setting-row input[type="checkbox"] {
  accent-color: var(--teal);
  width: 18px;
  height: 18px;
}
.slot {
  border: 1px solid #dce1d6;
  border-radius: 14px;
  background: #fffcf5;
  padding: 13px;
  margin-bottom: 10px;
}
.slot h3 {
  font-size: 13px;
  margin: 0 0 6px;
}
.slot p {
  font-size: 11px;
  color: var(--muted);
  margin: 3px 0 12px;
}
.slot.slot-auto { background: #eaf3fa; border-color: #99b8ce; }
.slot.slot-auto h3 { color: #315f7a; font-weight: 750; }
.slot-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
.slot-auto-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.slot-actions .btn { min-width: 0; padding-inline: 4px; white-space: nowrap; }
.slot-actions .btn.slot-delete, .modal .btn.slot-delete {
  background: #f9e5e1;
  border-color: #b68078;
  color: #903f36;
}
.slot-actions .btn.slot-delete:disabled { background: #eee9e4; color: #aaa29b; border-color: #c9c0b7; }
.modal-body .inventory-target { font-size: 15px; line-height: 1.5; color: #3e5349; }
.inventory-target-name { font-weight: 750; }
@media (max-width: 340px) { .slot-actions .btn { font-size: 11px; } }
.inventory-tool {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--button-edge);
  border-radius: 13px;
  padding: 13px;
  margin-bottom: 9px;
  text-align: left;
  width: 100%;
}
.inventory-tool .count {
  margin-left: auto;
  font-size: 17px;
  color: var(--teal);
  white-space: nowrap;
}
.inventory-tool strong {
  font-size: 13px;
}
.inventory-tool p {
  font-size: 10px;
  color: var(--muted);
  margin: 4px 0;
  line-height: 1.5;
}
.dialog {
  margin: 0 16px 14px;
  padding: 17px;
  background: #fffcf5;
  border: 1px solid #d5ded0;
  border-radius: 17px;
}
.event-kicker {
  font-size: 9px;
  letter-spacing: 2px;
  color: #b07c40;
  font-weight: 700;
}
.dialog h2 {
  font-size: 17px;
  margin: 8px 0 12px;
  line-height: 1.5;
}
.dialog-speaker {
  font-size: 11px;
  font-weight: 700;
  color: var(--teal);
  margin-bottom: 7px;
}
.dialog-text {
  font-size: 14px;
  line-height: 1.85;
  white-space: pre-wrap;
  min-height: 42px;
}
.dialog-actions {
  display: grid;
  gap: 7px;
  margin-top: 15px;
}
.dialog-page {
  font-size: 10px;
  color: var(--muted);
  text-align: right;
  margin-top: 9px;
}
.warning {
  padding: 12px;
  background: #f8e5d8;
  color: #8d5d43;
  border-radius: 12px;
  font-size: 11px;
  line-height: 1.7;
}
.error-screen {
  padding: 30px 24px;
}
.error-screen h1 {
  font-size: 23px;
}
.error-screen pre {
  white-space: pre-wrap;
  font-size: 11px;
  overflow-wrap: anywhere;
  background: #fff9eb;
  padding: 14px;
  border-radius: 12px;
}
.error-banner {
  padding: 10px 16px;
  background: #f8e5d8;
  color: #8f553b;
  font-size: 11px;
  white-space: pre-wrap;
}
#toast {
  position: fixed;
  bottom: max(25px, env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  max-width: calc(100vw - 32px);
  background: #233f49ee;
  color: white;
  box-shadow: 0 8px 30px #183b4933;
  border-radius: 14px;
  padding: 13px 18px;
  font-size: 12px;
  line-height: 1.6;
  z-index: 100;
  width: max-content;
}
.file-input {
  display: none;
}
@media (min-width: 700px) {
  .app {
    margin: 24px auto;
    min-height: calc(100dvh - 48px);
    border-radius: 28px;
    overflow: hidden;
  }
  .modal-overlay {
    padding: 30px;
  }
}
@media (max-height: 720px) {
  .footnote {
    margin-top: 16px;
  }
  .game-header {
    padding-top: 15px;
  }
  .hud {
    padding-bottom: 12px;
  }
}
.audio-volume {
  min-width: 5.5rem;
  padding: .45rem .6rem;
  border: 1px solid #b5c3a9;
  border-radius: .5rem;
  background: #fffef7;
  color: inherit;
  font: inherit;
}

/* Original arrow movie blocks game controls, not the browser's own navigation. */
#arrow-fx-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  touch-action: none;
}
#arrow-fx-overlay canvas {
  width: min(100vw, 960px);
  height: auto;
  image-rendering: pixelated;
}
#arrow-fx-overlay canvas[hidden] { display: none; }

/* Own-family setup keeps the original 240 x 160 screen. Compact native
 * controls fit inside its original frame; text inputs still support phone IME. */
.own-scene { --pixel-scale: 1; box-sizing: content-box; height: calc(160px * var(--pixel-scale)); }
.own-scene > .house-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
.own-scene-title {
  position: absolute; left: calc(15px * var(--pixel-scale)); right: calc(15px * var(--pixel-scale)); top: calc(10px * var(--pixel-scale));
  height: calc(13px * var(--pixel-scale)); margin: 0; padding: 0;
  line-height: calc(13px * var(--pixel-scale)); font-size: calc(9px * var(--pixel-scale));
  font-weight: 700; text-align: center; white-space: nowrap; overflow: hidden;
  color: #29263c; background: transparent; pointer-events: none;
  -webkit-text-size-adjust: 100%; text-size-adjust: 100%;
}
.own-input-panel {
  position: absolute; left: 4.5%; right: 4.5%; top: calc(43px * var(--pixel-scale)); bottom: calc(12px * var(--pixel-scale));
  overflow-y: auto; overscroll-behavior: contain;
  min-height: 0;
  padding: 0 calc(4px * var(--pixel-scale));
  font-size: 12px; line-height: 1.2;
  color: #29383b;
  display: flex;
  flex-direction: column;
}
.own-input-content { width: 100%; flex: none; display: flow-root; margin-block: auto; }
.own-input-panel button { cursor: pointer; touch-action: manipulation; }
.own-input-panel button:not(.btn), .own-date-grid section {
  border: 1px solid var(--button-edge); border-radius: 2px;
}
.own-input-panel .btn { min-height: 28px; padding: 3px 8px; font-size: 12px; line-height: 1.2; border-radius: 4px; }
.own-input-panel form { display: grid; gap: 4px; padding: 4px 0; }
.own-input-panel label { font-size: 12px; font-weight: 700; }
.own-native-input {
  width: 100%; height: 32px; min-height: 32px; font-size: 16px;
  padding: 3px 6px; border: 1px solid #d98258; border-radius: 0;
  background: #fff; color: #263b43; outline-color: #5db6d2;
}
.own-actions { display: flex; gap: 4px; justify-content: flex-end; margin: 4px 0 0; }
.own-help, .own-date-age, .own-date-status { margin: 4px 0; font-size: 11px; line-height: 1.2; color: #616875; }
.own-date-status { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 6px; min-height: 0; margin: 3px 0; overflow-wrap: anywhere; }
.own-date-status + .own-date-age.invalid { margin: 3px 0; }
.own-date-age { overflow-wrap: anywhere; }
.own-date-age.invalid, .own-date-status.invalid { color: #a62f2f; font-weight: 700; }
.own-error { margin: 3px 0; color: #a62f2f; font-size: 11px; font-weight: 700; }
.own-date-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; }
.own-date-grid section {
  display: grid; grid-template-rows: 13px 22px repeat(2, max(22px, calc(16px * var(--pixel-scale)))); gap: 2px;
  align-content: start; text-align: center; background: #fffdf2; padding: 2px;
}
.own-date-grid section > span { font-size: 11px; line-height: 13px; }
.own-date-grid strong { font-size: 18px; line-height: 22px; }
.own-date-grid section > div { display: flex; gap: 2px; min-height: 0; }
.own-date-grid button { flex: 1; min-width: 0; height: 100%; min-height: 0; padding: 1px; font-size: 12px; }
.own-tree { position: relative; height: calc(70px * var(--pixel-scale)); }
/* Family-composition relationship guide: original8boxes/roles are unchanged.
 * Solid native gold couple joins + central trunk + four orthogonal child drops.
 * SVG is decorative CSS-only presentation, always behind the actual buttons. */
.own-tree::before {
  content: "";
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  z-index: 0;
  background: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20100%20100%22%20preserveAspectRatio%3D%22none%22%3E%3Cpath%20d%3D%22M46%2015H54%20M46%2050H54%20M50%2015V67.5%20M11.5%2070V67.5H88.3V70%20M37.1%2067.5V70%20M62.7%2067.5V70%22%20fill%3D%22none%22%20stroke%3D%22%23827344%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22square%22%20stroke-linejoin%3D%22miter%22%20vector-effect%3D%22non-scaling-stroke%22%2F%3E%3C%2Fsvg%3E") center / 100% 100% no-repeat;
  pointer-events: none;
}
.own-tree::after { content: none; }
.own-role { position: absolute; z-index: 1; height: 30%; padding: 1px; font-size: 12px; font-weight: 700; }
.own-role.role-0, .own-role.role-2 { left: 12%; width: 34%; }
.own-role.role-1, .own-role.role-3 { right: 12%; width: 34%; }
.own-role.role-0, .own-role.role-1 { top: 0; }
.own-role.role-2, .own-role.role-3 { top: 35%; }
.own-role[class*="child-"] { width: 23%; top: 70%; }
.own-role.child-0 { left: 0; }.own-role.child-1 { left: 25.6%; }.own-role.child-2 { left: 51.2%; }.own-role.child-3 { left: 76.8%; }
.own-member-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; margin: 0; }
.own-member { display: flex; align-items: center; gap: 2px; min-width: 0; min-height: 56px; padding: 3px; text-align: left; }
.own-member canvas { flex: none; width: 16px; height: 32px; image-rendering: pixelated; }
.own-member span { flex: 1; min-width: 0; }
.own-member strong, .own-member small { display: block; overflow-wrap: anywhere; }
.own-member strong { font-size: 10px; line-height: 12px; }
.own-member small { font-size: 10px; line-height: 11px; }
.own-member b { font-size: 10px; color: #43876b; }
[data-own-step="choose"] > .own-input-content { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-content: start; gap: 4px; }
[data-own-step="choose"] .own-member-list, [data-own-step="choose"] .own-error { grid-column: 1 / -1; }
[data-own-step="choose"] .own-actions { margin: 0; }
.own-choice-row { display: flex; flex-wrap: wrap; gap: 4px; margin: 6px 0; }
.own-choice-row button { flex: 1; min-height: 32px; padding: 3px; }
.own-rank-heading { margin: 3px 0; font-weight: 700; }
[data-own-step="rank"] .own-actions { display: inline-flex; float: right; margin: 0; }
.own-job-list { display: grid; grid-template-columns: 1fr 1fr; gap: 3px; }
.own-job-list button { min-height: 24px; padding: 2px 3px; font-size: 11px; }
.own-page-controls { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin: 4px 0; font-size: 11px; }
.own-page-controls button { min-width: 32px; min-height: 22px; padding: 1px; }
[data-own-step="job"] .own-actions .btn { min-height: 26px; }
.own-job-footer { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-top: 4px; }
.own-job-footer .own-page-controls { flex: 1; margin: 0; }
.own-job-footer .own-actions { flex-wrap: nowrap; margin: 0; }
.own-gallery { display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; }
.own-gallery button { min-width: 0; padding: 0; }
.own-gallery canvas { width: 100%; height: auto; image-rendering: pixelated; display: block; }
.own-build-row { display: flex; gap: 6px; }.own-build-row button { flex: 1; }
.own-build-row canvas { width: 64px; height: 128px; max-width: 100%; image-rendering: pixelated; }.own-build-row span { display: block; }
.own-look-confirm { display: flex; align-items: center; justify-content: center; gap: 28px; }
.own-look-confirm canvas, .own-color-editor > canvas { width: 64px; height: 128px; image-rendering: pixelated; }
.own-look-confirm > div { display: grid; gap: 8px; }.own-look-confirm button { min-width: 110px; min-height: 44px; }
.own-color-editor { display: flex; gap: 10px; }.own-color-editor > div { flex: 1; display: grid; gap: 6px; }
.own-color-editor > div > div { display: grid; grid-template-columns: 1fr 36px 34px 36px; align-items: center; gap: 2px; }
.own-color-editor button { min-height: 40px; padding: 0; }.own-color-editor strong { text-align: center; }
.own-summary { display: flex; align-items: flex-start; gap: 8px; }
.own-summary > canvas { flex: none; width: 48px; height: 96px; image-rendering: pixelated; }
.own-summary dl { flex: 1; min-width: 0; display: grid; grid-template-columns: 70px minmax(0, 1fr); gap: 4px; margin: 0; font-size: 11px; line-height: 14px; }
.own-summary dt { margin: 0; color: #69737e; }
.own-summary dd { margin: 0; overflow-wrap: anywhere; }
[data-own-step="summary"] .own-actions .btn { min-height: 26px; font-size: 11px; }

/* Individual original parts composer, not a finished-character preset grid. */
.own-parts-workspace { display: grid; grid-template-columns: minmax(0, 1fr) calc(40px * var(--pixel-scale)) minmax(0, 1fr); align-items: start; gap: 4px; }
.own-parts-hero { display: grid; justify-items: center; align-content: start; gap: 2px; min-height: 0; margin: 0; text-align: center; }
.own-parts-display { display: grid; justify-items: center; gap: 2px; min-width: 0; text-align: center; }
.own-parts-display strong { max-width: 100%; font-size: clamp(11px, calc(8px * var(--pixel-scale)), 14px); line-height: 1; overflow-wrap: anywhere; }
.own-parts-hero > canvas, .own-parts-display > canvas { display: block; width: calc(32px * var(--pixel-scale)); height: calc(48px * var(--pixel-scale)); image-rendering: pixelated; }
.own-parts-hero p { margin: 0; font-size: 11px; color: #6b6577; }
.own-parts-hint { text-align: center; }
.own-parts-hint p { display: none; }
.own-parts-hero button { min-height: max(22px, calc(14px * var(--pixel-scale))); padding: 2px 3px; font-size: 10px; }
.own-parts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
.own-parts-column { display: grid; grid-template-columns: minmax(0, 1fr); gap: 3px; }
.own-part-control { min-width: 0; }
.own-part-control label { display: block; margin-bottom: 1px; font-size: 11px; line-height: 12px; font-weight: 700; text-align: center; }
.own-part-control > div { display: grid; grid-template-columns: max(18px, calc(12px * var(--pixel-scale))) minmax(0, 1fr) max(18px, calc(12px * var(--pixel-scale))); gap: 2px; height: max(20px, calc(14px * var(--pixel-scale))); }
.own-part-control button { height: 100%; min-height: 0; padding: 0; font-size: 10px; }
.own-part-control select { width: 100%; min-width: 0; height: 100%; border: 1px solid #bfaf84; border-radius: 2px; background: #fff; color: #29383b; font: inherit; font-size: 11px; padding: 0 1px; text-align: center; text-align-last: center; }
.own-extra-parts { margin-top: 4px; }
.own-extra-parts > summary { min-height: 24px; cursor: pointer; color: #645b77; font-size: 10px; font-weight: 700; text-align: center; }
.own-extra-parts .own-parts-grid { margin: 4px 0; }
.own-setup-screen .own-actions { flex-wrap: wrap; }
.own-parts-footer { display: flex; align-items: center; justify-content: space-between; gap: 3px; margin-top: 4px; }
.own-parts-footer > button, .own-parts-footer > button.btn { min-height: 24px; padding: 2px 4px; font-size: 10px; }
.own-parts-footer .own-actions { flex-wrap: nowrap; gap: 3px; margin: 0; }
.own-parts-footer .own-actions .btn { min-height: 24px; padding: 2px 4px; font-size: 10px; white-space: nowrap; }

@media (max-width: 340px) {
  .own-input-panel { padding: 0 3px; }
  .own-input-panel .btn { min-height: 24px; padding-inline: 5px; }
  .own-tree { height: calc(64px * var(--pixel-scale)); }
  [data-own-step="composition"] .own-help { margin: 2px 0; }
  .own-member { gap: 1px; min-height: 44px; padding: 1px; }
  .own-member canvas { width: 12px; height: 24px; }
  .own-member strong, .own-member small { font-size: 9px; line-height: 10px; }
  .own-member b { display: none; }
  [data-own-step="birth"] > .own-input-content { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-content: start; gap: 2px; }
  [data-own-step="birth"] .own-date-grid, [data-own-step="birth"] .own-date-age.invalid, [data-own-step="birth"] .own-error { grid-column: 1 / -1; }
  [data-own-step="birth"] .own-date-status { grid-column: 1; grid-row: 2; align-self: center; margin: 0; }
  [data-own-step="birth"] .own-actions { grid-column: 2; grid-row: 2; align-self: center; flex-wrap: nowrap; gap: 2px; margin: 0; }
  [data-own-step="birth"] .own-actions .btn { padding-inline: 3px; font-size: 10px; }
  .own-job-list { gap: 2px; }
  .own-job-list button { min-height: 20px; font-size: 10px; }
  .own-job-footer { gap: 4px; }
  .own-job-footer .own-page-controls { gap: 3px; font-size: 10px; }
  .own-job-footer .own-page-controls button { min-width: 22px; min-height: 22px; }
  .own-job-footer .own-actions { gap: 2px; }
  .own-job-footer .own-actions .btn { min-height: 22px; padding-inline: 4px; font-size: 10px; }
  .own-summary dl { grid-template-columns: 54px minmax(0, 1fr); gap: 2px; font-size: 10px; line-height: 12px; }
  .own-summary > canvas { width: 36px; height: 72px; }
  [data-own-step="summary"] .own-actions .btn { min-height: 24px; font-size: 10px; }
  .own-parts-hero, .own-parts-display { gap: 1px; }
  .own-parts-display strong { font-size: 10px; line-height: 10px; }
  .own-parts-hero button { min-height: 20px; padding-block: 1px; }
  .own-parts-column { gap: 1px; }
  .own-part-control label, .own-part-control select { font-size: 10px; }
  .own-part-control label { line-height: 11px; }
  .own-part-control > div { height: 18px; }
  .own-parts-footer { margin-top: 2px; }
  .own-parts-footer, .own-parts-footer .own-actions { gap: 2px; }
  .own-parts-footer > button, .own-parts-footer > button.btn, .own-parts-footer .own-actions .btn { min-height: 22px; padding: 1px 3px; }
}

/* Shared game controls: ivory/gold panels with jade and blue accents.
 * Inset outlines preserve the dimensions of the original scene/dialogue;
 * sprite-backed dialogue and the invisible Cupid hit target stay untouched. */
button:not(.dialogue-frame):not(.cupid-tip-trigger) {
  background: var(--button-fill, var(--button-ivory));
  color: var(--button-text, var(--button-ink));
  border-color: var(--button-stroke, var(--button-edge));
  box-shadow:
    inset 0 0 0 2px var(--button-stroke, var(--button-edge)),
    inset 0 4px 0 2px #ffffff85,
    0 2px 0 #82734435;
  -webkit-tap-highlight-color: transparent;
}
button:is([aria-pressed="true"], [aria-selected="true"], .selected, .active):not(.dialogue-frame):not(.cupid-tip-trigger) {
  --button-fill: var(--button-blue);
  --button-stroke: #3c687e;
  --button-text: #234659;
}
.own-input-panel button.own-member.complete {
  --button-fill: var(--button-jade);
  --button-stroke: #567357;
  --button-text: #294638;
}
button:not(.dialogue-frame):not(.cupid-tip-trigger):not(:disabled):active {
  box-shadow:
    inset 0 0 0 2px var(--button-stroke, var(--button-edge)),
    inset 0 4px 0 2px #82734425;
}
button:not(.dialogue-frame):not(.cupid-tip-trigger):disabled {
  --button-fill: #e4e5da;
  --button-stroke: #939886;
  --button-text: #596151;
  opacity: 1;
  box-shadow: inset 0 0 0 1.5px var(--button-stroke);
}
@media (hover: hover) and (pointer: fine) {
  button:not(.dialogue-frame):not(.cupid-tip-trigger):not(:disabled):hover {
    box-shadow:
      inset 0 0 0 2px var(--button-stroke, var(--button-edge)),
      inset 0 0 0 4px #ffffff80,
      0 2px 0 #82734435;
  }
  button:not(.dialogue-frame):not(.cupid-tip-trigger):not(:disabled):hover:active {
    box-shadow:
      inset 0 0 0 2px var(--button-stroke, var(--button-edge)),
      inset 0 4px 0 2px #82734425;
  }
}

/* The original-size family panel uses the same palette with thinner insets. */
.own-setup-screen .own-input-panel button {
  box-shadow:
    inset 0 0 0 1px var(--button-stroke, var(--button-edge)),
    inset 0 2px 0 1px #ffffff85;
}
.own-setup-screen .own-input-panel button:not(:disabled):active {
  box-shadow:
    inset 0 0 0 1px var(--button-stroke, var(--button-edge)),
    inset 0 2px 0 1px #82734425;
}
.own-setup-screen .own-input-panel button:disabled {
  box-shadow: inset 0 0 0 1px var(--button-stroke);
}
.own-input-panel :is(button, input, select):focus-visible { outline-width: 2px; outline-offset: 1px; }

/* Recommended review uses the same original240x160 plate and top position.
 * Only content inside the original white panels is vertically centered. */
.recommended-scene button { cursor: pointer; touch-action: manipulation; }
.recommended-summary-panel {
  position: absolute; left: calc(23px * var(--pixel-scale)); right: calc(23px * var(--pixel-scale));
  top: calc(38px * var(--pixel-scale)); bottom: calc(23px * var(--pixel-scale));
  display: flex; flex-direction: column; min-height: 0; color: #29263c;
  font-size: calc(9px * var(--pixel-scale)); line-height: 1.15;
}
.recommended-start-date { margin: 0 0 calc(3px * var(--pixel-scale)); text-align: center; font-size: calc(12px * var(--pixel-scale)); font-weight: 700; }
.recommended-family-summary { display: grid; grid-template-columns: calc(50px * var(--pixel-scale)) minmax(0, 1fr); gap: calc(2px * var(--pixel-scale)); margin: 0; }
.recommended-family-summary dt { color: #34833e; font-weight: 700; }
.recommended-family-summary dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
.recommended-roles { display: grid; grid-template-columns: 1fr 1fr; gap: calc(1px * var(--pixel-scale)) calc(4px * var(--pixel-scale)); }
.recommended-summary-panel .own-actions { margin-top: calc(3px * var(--pixel-scale)); }
.recommended-summary-panel .btn, #recommended-detail-ok { min-height: calc(17px * var(--pixel-scale)); padding: calc(1px * var(--pixel-scale)) calc(5px * var(--pixel-scale)); font-size: calc(10px * var(--pixel-scale)); line-height: 1.2; border-radius: 2px; }
.recommended-portraits { position: absolute; left: calc(8px * var(--pixel-scale)); right: calc(8px * var(--pixel-scale)); top: calc(35px * var(--pixel-scale)); height: calc(57px * var(--pixel-scale)); display: flex; align-items: flex-end; justify-content: center; gap: calc(2px * var(--pixel-scale)); }
.recommended-portraits canvas { display: block; flex: 0 1 calc(26px * var(--pixel-scale)); width: calc(26px * var(--pixel-scale)); height: auto; aspect-ratio: 1 / 2; max-height: calc(52px * var(--pixel-scale)); min-width: 0; image-rendering: pixelated; }
.recommended-list-panel { position: absolute; left: calc(12px * var(--pixel-scale)); right: calc(12px * var(--pixel-scale)); top: calc(104px * var(--pixel-scale)); bottom: calc(9px * var(--pixel-scale)); display: grid; grid-template-rows: max-content calc(12px * var(--pixel-scale)); align-content: center; gap: calc(3px * var(--pixel-scale)); color: #29263c; }
.recommended-names { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(var(--recommended-name-rows, 3), calc(10px * var(--pixel-scale))); gap: calc(1px * var(--pixel-scale)) calc(3px * var(--pixel-scale)); min-height: 0; }
.recommended-screen .recommended-scene :is(.recommended-names, .recommended-list-actions) > button {
  box-sizing: border-box; min-width: 0; min-height: 0; width: 100%; height: 100%; margin: 0; padding: 0 calc(2px * var(--pixel-scale));
  border: max(1px, calc(.5px * var(--pixel-scale))) solid #b7999f; border-radius: calc(1px * var(--pixel-scale));
  box-shadow: none; background: #fffaf2; color: #302638; font-size: calc(9px * var(--pixel-scale)); line-height: 1;
  display: grid; place-items: center; text-align: center; white-space: nowrap; overflow-wrap: normal;
}
.recommended-name-empty { min-width: 0; min-height: 0; visibility: hidden; pointer-events: none; }
.recommended-list-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(5px * var(--pixel-scale)); min-height: 0; }
.recommended-screen .recommended-scene .recommended-list-actions > button { border-color: #98875f; background: #f6f0df; font-weight: 700; }
.recommended-screen .recommended-scene .recommended-list-actions > .recommended-default { background: #ffe0ea; border-color: #b2708a; }
.recommended-screen .recommended-scene :is(.recommended-names, .recommended-list-actions) > button:not(:disabled):is(:hover, :focus-visible, :active) { box-shadow: none; background: #f9dfe9; border-color: #965e75; outline: none; }
.recommended-screen .recommended-scene :is(.recommended-names, .recommended-list-actions) > button:focus-visible { outline: 1px solid #6b7598; outline-offset: -2px; }
.recommended-detail-portrait { position: absolute; left: calc(24px * var(--pixel-scale)); top: calc(31px * var(--pixel-scale)); width: calc(20px * var(--pixel-scale)); height: calc(25px * var(--pixel-scale)); image-rendering: pixelated; }
#recommended-detail-ok { position: absolute; right: calc(25px * var(--pixel-scale)); top: calc(34px * var(--pixel-scale)); }
.recommended-detail-data { position: absolute; left: calc(15px * var(--pixel-scale)); right: calc(15px * var(--pixel-scale)); top: calc(67px * var(--pixel-scale)); bottom: calc(23px * var(--pixel-scale)); display: grid; grid-template-rows: repeat(4, calc(13px * var(--pixel-scale))) calc(14px * var(--pixel-scale)); gap: calc(1px * var(--pixel-scale)); font-size: calc(8px * var(--pixel-scale)); line-height: 1.1; color: #29263c; }
.recommended-detail-data p { margin: 0; min-width: 0; }
.recommended-detail-row { box-sizing: border-box; min-width: 0; min-height: 0; padding: calc(1px * var(--pixel-scale)) calc(3px * var(--pixel-scale)); border: max(1px, calc(.5px * var(--pixel-scale))) solid #dfcdd0; border-radius: calc(1px * var(--pixel-scale)); display: grid; align-items: center; background: #fffdf6; }
.recommended-detail-identity { background: #faedf2; }
.recommended-detail-name, .recommended-detail-birthday, .recommended-detail-traits { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: calc(2px * var(--pixel-scale)); }
.recommended-detail-traits { background: #f2f6ed; }
.recommended-detail-abilities { background: #f6f2fb; }
.recommended-detail-job { grid-template-columns: auto minmax(0, 1fr); gap: calc(4px * var(--pixel-scale)); background: #fff5e6; }
.recommended-field { display: flex; align-items: baseline; gap: calc(2px * var(--pixel-scale)); min-width: 0; white-space: nowrap; }
.recommended-field-label { flex: none; color: #65596b; font-size: calc(7px * var(--pixel-scale)); font-weight: 650; white-space: nowrap; }
.recommended-field-value, .recommended-detail-name strong { min-width: 0; font-weight: 700; white-space: nowrap; }
.recommended-ranks { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: calc(2px * var(--pixel-scale)); min-width: 0; white-space: nowrap; }
.recommended-ranks b { font-size: calc(9px * var(--pixel-scale)); line-height: 1; }
.recommended-ranks .rank-0 { color: #3e8533; }.recommended-ranks .rank-1 { color: #cf382d; }.recommended-ranks .rank-2 { color: #266ca9; }.recommended-ranks .rank-3 { color: #a65c08; }
.recommended-interjection { position: absolute; left: 18.75%; right: 20.4167%; top: 28.125%; min-height: 31.875%; z-index: 5; display: flex; flex-direction: column; justify-content: center; gap: calc(3px * var(--pixel-scale)); padding: calc(4px * var(--pixel-scale)) calc(8px * var(--pixel-scale)); border: calc(3px * var(--pixel-scale)) double #b74b72; background: #fffde7; box-shadow: inset 0 0 0 calc(2px * var(--pixel-scale)) #ffd3e1; }
.recommended-interjection > span { display: none; }
.recommended-interjection button { min-height: calc(15px * var(--pixel-scale)); padding: 0; border: 0; border-radius: 0; box-shadow: none; background: transparent; color: #29263c; text-align: center; font-size: calc(10px * var(--pixel-scale)); line-height: 1.2; }
.recommended-interjection button:hover, .recommended-interjection button:focus-visible { background: #ffe0ea; outline: 1px solid #ca7592; }
.recommended-scene [inert] { pointer-events: none; }
/* During narration the original canvas still paints its paper frame. Hide
 * only inactive DOM content that would otherwise paint over Cupid. Family
 * figures stay visible and temporarily leave him a lane on their left. */
.recommended-dialogue-scene :is(.recommended-date-panel, .recommended-summary-panel, .recommended-detail-data, #recommended-detail-ok) { visibility: hidden; }
.recommended-dialogue-scene[data-recommended-step="list"] .recommended-portraits { left: calc(46px * var(--pixel-scale)); }
@media (hover: hover) and (pointer: fine) {
  .own-setup-screen .own-input-panel button:not(:disabled):hover {
    box-shadow:
      inset 0 0 0 1px var(--button-stroke, var(--button-edge)),
      inset 0 0 0 2px #ffffff80;
  }
  .own-setup-screen .own-input-panel button:not(:disabled):hover:active {
    box-shadow:
      inset 0 0 0 1px var(--button-stroke, var(--button-edge)),
      inset 0 2px 0 1px #82734425;
  }
}

/* Phone-sized text should not grow to the mobile width cap on a desktop.
 * Match a compact handset viewport only on wide, mouse-operated screens.
 * Touch layouts, native text inputs and the original scene aspect stay intact. */
@media (min-width: 700px) and (hover: hover) and (pointer: fine) {
  .app { max-width: 390px; }
  .boot h1 { font-size: 32px; }
  .event-scene-title {
    font-weight: 700;
    font-synthesis: none;
    -webkit-text-stroke: 0;
  }
}

/* Main play has a compact, viewport-aware chrome. Creation/title plates keep
 * their existing layout; neither the native scene nor its artwork is stretched. */
.app:has(> .game-header) {
  --main-width-cap: 480px;
  display: flex;
  flex-direction: column;
  min-height: 100dvh;
  margin: 0 auto;
  border-radius: 0;
}
.app:has(> .game-header) > * { flex-shrink: 0; }
.app:has(> .game-header) .game-header { padding: 8px 12px 4px; align-items: center; gap: 8px; }
.app:has(> .game-header) .game-header h1 { margin-top: 1px; line-height: 1.1; }
.app:has(> .game-header) .game-header .overline { line-height: 1.2; }
.app:has(> .game-header) .icon-button { height: 34px; min-width: 34px; border-radius: 9px; }
.app:has(> .game-header) .hud { padding: 0 12px 7px; gap: 8px; line-height: 1.2; }
.app:has(> .game-header) .day-line { padding: 8px 12px; gap: 6px; }
.app:has(> .game-header) .day-line .speed-label { min-width: 0; line-height: 1.2; }
.app:has(> .game-header) .day-line .btn.small { min-height: 32px; padding: 6px 9px; line-height: 1.2; }
.app:has(> .game-header) .fast-btn { min-height: 32px; padding: 6px 7px; line-height: 1.2; border-radius: 8px; white-space: nowrap; }
.app:has(> .game-header) .member-panel { display: flex; flex: 1 0 auto; align-items: center; gap: 6px; margin: 0 12px 10px; padding: 8px; border-radius: 13px; }
.app:has(> .game-header) .member-content { flex: 1; min-width: 0; align-self: stretch; display: flex; flex-direction: column; }
.app:has(> .game-header) .member-content > * { flex-shrink: 0; }
.app:has(> .game-header) .member-content .interest-description { flex: 1 0 auto; display: flex; flex-direction: column; justify-content: center; }
.app:has(> .game-header) .event-advance-area, .app:has(> .intro-screen) .event-advance-area { --event-side-inset: 12px; flex: 1 0 auto; min-height: 160px; display: flex; align-items: center; justify-content: center; margin: 0 12px 10px; }
/* Half the former side gaps, including the play panel's outer inset. */
.app:has(> .game-header) .event-advance-button, .app:has(> .intro-screen) .event-advance-button { flex: none; width: calc(50% + 130px + var(--event-side-inset)); max-width: calc(100% - 16px + var(--event-side-inset)); height: 148px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px; min-height: 148px; padding: 10px; border-radius: 18px; background: #eef3e9; color: var(--teal); box-shadow: inset 0 0 0 2px #dbe6d4; }
.app:has(> .game-header) .event-advance-icon, .app:has(> .intro-screen) .event-advance-icon { font-size: 72px; line-height: 1; padding-left: .08em; }
.app:has(> .game-header) .event-advance-label, .app:has(> .intro-screen) .event-advance-label { font-size: 14px; font-weight: 650; line-height: 1.2; }
.app:has(> .game-header) .event-advance-button:disabled, .app:has(> .intro-screen) .event-advance-button:disabled { color: #8b9989; background: #f0f2eb; }
.app:has(> .game-header) .event-advance-button:not(:disabled):active, .app:has(> .intro-screen) .event-advance-button:not(:disabled):active { background: #dfead8; }
.app:has(> .game-header) .event-advance-button[hidden], .app:has(> .intro-screen) .event-advance-button[hidden] { display: none; }
.app:has(> .game-header) .member-nav { gap: 6px; }
.app:has(> .game-header) .nav-arrow { flex: 0 0 28px; height: 32px; align-self: center; display: flex; align-items: center; justify-content: center; line-height: 1; }
.app:has(> .game-header) .nav-chevron { display: block; line-height: 1; transform: translateY(-1px); }
.app:has(> .game-header) .portrait { width: 48px; height: 56px; border-radius: 8px; object-position: center; }
.app:has(> .game-header) .portrait[data-sex="male"] { background: #e1f2ff; }
.app:has(> .game-header) .portrait[data-sex="female"] { background: #ffe8ef; }
.app:has(> .game-header) .member-name { flex-wrap: wrap; gap: 2px 5px; line-height: 1.15; overflow-wrap: anywhere; }
.app:has(> .game-header) .member-age { white-space: nowrap; }
.app:has(> .game-header) .member-job { margin-top: 2px; line-height: 1.2; overflow-wrap: anywhere; }
.app:has(> .game-header) .member-right { display: flex; flex: none; flex-direction: row; align-items: center; gap: 6px; }
.app:has(> .game-header) .member-id .member-hearts { display: flex; flex-wrap: wrap; gap: 2px; margin: 3px 0 0; }
.app:has(> .game-header) .member-id .heart { flex: none; width: 27px; height: 27px; }
.app:has(> .game-header) .member-id .heart-fallback { font-size: 27px; line-height: 1; }
.app:has(> .game-header) .member-more { flex: none; min-height: 32px; padding: 5px; white-space: nowrap; }
.app:has(> .game-header) .activity { padding: 5px 0 0; gap: 6px; font-size: 14px; font-weight: 750; }
.app:has(> .game-header) .activity .label { padding: 2px 5px; line-height: 1.2; font-size: 12px; font-weight: 750; }
.app:has(> .game-header) .activity-text { min-width: 0; line-height: 1.3; overflow-wrap: anywhere; font-weight: 800; }
.app:has(> .game-header) .gauge-wrap { display: grid; grid-template-columns: 88px minmax(0, 1fr); align-items: center; gap: 8px; margin-top: 6px; }
.app:has(> .game-header) .gauge-label { margin: 0; gap: 6px; line-height: 1.2; }
.app:has(> .game-header) .game-tools { margin-top: auto; padding: 0 12px 8px; gap: 6px; }
.app:has(> .game-header) .tool-button { min-height: 66px; padding: 6px 3px; gap: 4px; border-radius: 12px; font-size: 11px; line-height: 1.2; }
.app:has(> .game-header) .tool-button .tool-icon { width: 40px; height: 40px; flex-basis: 40px; }
.app:has(> .game-header) .tool-button .menu-tool-icon { width: 40px; height: 40px; }
.app:has(> .game-header) .game-footer { padding: 6px 12px; gap: 8px; line-height: 1.2; }
@media (max-width: 340px), (max-height: 600px) {
  .app:has(> .game-header) .member-more { width: 36px; min-height: 40px; padding: 3px 2px; white-space: normal; }
}
@media (min-width: 700px) and (hover: hover) and (pointer: fine) {
  .app:has(> .game-header) { --main-width-cap: 390px; }
}
@media (max-height: 700px) {
  .app:has(> .game-header) { max-width: min(var(--main-width-cap), calc((100dvh - 300px) * 1.5)); }
  .app:has(> .game-header) .game-header { padding: 2px 10px; }
  .app:has(> .game-header) .game-header > div { display: block; min-width: 0; }
  .app:has(> .game-header) .game-header h1 { margin: 0; }
  .app:has(> .game-header) .game-header .overline { letter-spacing: .5px; }
  .app:has(> .game-header) .hud { padding: 0 10px 2px; }
  .app:has(> .game-header) .day-line { padding: 4px 10px; gap: 4px; }
  .app:has(> .game-header) .day-line .btn.small { padding-inline: 7px; }
  .app:has(> .game-header) .member-panel { margin: 0 10px 4px; padding: 6px; }
  .app:has(> .game-header) .member-nav { gap: 5px; }
  .app:has(> .game-header) .portrait { width: 48px; }
  .app:has(> .game-header) .activity { padding-top: 4px; }
  .app:has(> .game-header) .interest-description { padding: 5px 7px; }
  .app:has(> .game-header) .gauge-wrap { margin-top: 4px; }
  .app:has(> .game-header) .game-tools { padding: 0 10px 4px; gap: 5px; }
  .app:has(> .game-header) .tool-button { min-height: 60px; padding-block: 4px; }
  .app:has(> .game-header) .tool-button .tool-icon { width: 36px; height: 36px; flex-basis: 36px; }
  .app:has(> .game-header) .tool-button .menu-tool-icon { width: 36px; height: 36px; }
  .app:has(> .game-header) .game-footer { padding: 3px 10px; }
  .app:has(> .game-header) .event-advance-area, .app:has(> .intro-screen) .event-advance-area { --event-side-inset: 10px; margin: 0 10px 4px; }
}
@media (max-height: 600px) {
  .app:has(> .game-header) { max-width: min(var(--main-width-cap), calc((100dvh - 360px) * 1.5)); }
  .app:has(> .game-header) .event-advance-area, .app:has(> .intro-screen) .event-advance-area { min-height: 136px; }
  .app:has(> .game-header) .event-advance-button, .app:has(> .intro-screen) .event-advance-button { width: calc(50% + 120px + var(--event-side-inset)); height: 124px; min-height: 124px; }
  .app:has(> .game-header) .event-advance-icon, .app:has(> .intro-screen) .event-advance-icon { font-size: 58px; }
  .app:has(> .game-header) .activity { padding-top: 3px; }
  .app:has(> .game-header) .interest-description { margin-top: 4px; padding: 5px 7px; font-size: 13px; line-height: 1.5; }
  .app:has(> .game-header) .gauge-wrap { margin-top: 3px; }
}

/* Code-native sky/city decoration; reference-only ROM screenshots are absent. */
.cupid-overlay { padding: 12px; }
.cupid-modal { max-width: 456px; max-height: 92dvh; background: #d6f0f7; }
.cupid-modal .modal-header { padding: 12px 14px; border-color: #87b6c466; background: #f8ffffe8; }
.cupid-modal .modal-header h2 { font-size: 17px; }
.cupid-modal .modal-body { padding: 0; }
.cupid-shell { isolation: isolate; position: relative; padding: 12px; overflow: hidden; background: linear-gradient(#87d9f6 0, #c9f1ff 46%, #eff8e6 100%); }
.cupid-shell::before, .cupid-shell::after { content: ""; position: absolute; z-index: -1; pointer-events: none; background: #ffffffe0; border-radius: 50%; box-shadow: 25px 6px 0 8px #ffffffcc, 50px 0 0 4px #ffffffd9; }
.cupid-shell::before { width: 62px; height: 24px; top: 106px; left: -22px; }
.cupid-shell::after { width: 48px; height: 20px; top: 70px; right: 70px; }
.cupid-skyline { position: absolute; z-index: -1; bottom: 0; left: 0; right: 0; height: 168px; display: flex; align-items: end; justify-content: space-around; gap: 7px; opacity: .42; pointer-events: none; }
.cupid-skyline i { flex: 1; max-width: 44px; height: 84px; background: repeating-linear-gradient(0deg, transparent 0 12px, #e7faf5 12px 16px), repeating-linear-gradient(90deg, #83b6ca 0 9px, #def4f7 9px 13px); border: 2px solid #78aabc; border-radius: 4px 4px 0 0; }
.cupid-skyline i:nth-child(2n) { height: 114px; background-color: #a8c9a5; }
.cupid-skyline i:nth-child(3n) { height: 62px; background-color: #c3c3b1; }
.cupid-skyline i:nth-child(5) { height: 141px; border-radius: 9px 9px 0 0; }
.cupid-summary { border: 1px solid #78a999; border-radius: 10px; padding: 8px 10px; background: #f0fff2e8; box-shadow: inset 0 0 0 2px #ffffffa3; margin-bottom: 12px; }
.cupid-summary > div { display: flex; align-items: baseline; gap: 9px; flex-wrap: wrap; }
.cupid-summary strong { font-size: 17px; overflow-wrap: anywhere; }
.cupid-summary span { font-size: 12px; white-space: nowrap; }
.cupid-summary p { display: flex; gap: 8px; justify-content: space-between; margin: 5px 0 0; font-size: 12px; line-height: 1.4; }
.cupid-summary b { font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.cupid-stage { display: grid; grid-template-columns: 68px minmax(0, 1fr); gap: 8px; align-items: center; }
.cupid-guide { align-self: center; display: grid; place-items: center; min-width: 0; }
.cupid-guide img { display: block; width: 72px; height: 72px; object-fit: contain; image-rendering: pixelated; filter: drop-shadow(0 5px 0 #5290a629); animation: cupid-sky-float 2.3s ease-in-out infinite; }
@keyframes cupid-sky-float { 50% { transform: translateY(-5px); } }
.cupid-panel { min-width: 0; border: 2px solid #819578; border-radius: 12px; background: #fbfff6f2; box-shadow: inset 0 0 0 3px #ffffffe0, 0 3px 0 #57869220; overflow: hidden; padding: 9px; }
.cupid-menu-list { display: grid; gap: 3px; }
.cupid-menu-row { width: 100%; min-height: 35px; text-align: left; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 7px 9px; background: transparent; border-radius: 6px; color: #2b4840; font-size: 14px; line-height: 1.3; }
.cupid-menu-row:hover, .cupid-menu-row:focus-visible { background: #e3f2ce; }
.cupid-menu-row > span:first-child { overflow-wrap: anywhere; }
.cupid-menu-row > span:last-child { font-size: 22px; line-height: 16px; color: #94a463; }
.cupid-speech { position: relative; margin: 15px 0 10px; padding: 9px 12px 11px; background: #fffefa; border: 2px solid #77b3c2; border-radius: 14px; box-shadow: inset 0 0 0 2px #e1f8ff; }
.cupid-speech::before { content: ""; position: absolute; top: -9px; left: 29px; width: 14px; height: 14px; border-top: 2px solid #77b3c2; border-left: 2px solid #77b3c2; transform: rotate(45deg); background: #fffefa; }
.cupid-speaker { position: relative; color: #3b8990; font-size: 11px; font-weight: 750; letter-spacing: .5px; }
.cupid-modal .cupid-speech p { position: relative; margin: 4px 0 0; font-size: 13px; line-height: 1.65; white-space: pre-line; overflow-wrap: anywhere; text-align: left; }
.cupid-mood { max-width: 285px; margin: 12px auto 4px; padding: 8px 9px; border: 1px solid #7faca7; border-radius: 9px; background: #faffefd9; }
.cupid-mood-track { display: grid; grid-template-columns: 12px repeat(5, minmax(0, 1fr)) 16px; align-items: center; gap: 4px; }
.cupid-mood-track > span { text-align: center; font-size: 13px; font-weight: 750; }
.cupid-mood-cell { height: 13px; display: block; background: #e9eee7; border: 1px solid #8facaa; border-radius: 3px; }
.cupid-mood-cell.is-lit { border-color: #3d726f; box-shadow: 0 0 0 1px #ffffff, inset 0 2px 0 #ffffff88; }
.cupid-mood-cell.mood-0.is-lit { background: #4386d5; }
.cupid-mood-cell.mood-1.is-lit { background: #35bcb9; }
.cupid-mood-cell.mood-2.is-lit { background: #9acb55; }
.cupid-mood-cell.mood-3.is-lit { background: #ecc749; }
.cupid-mood-cell.mood-4.is-lit { background: #ef7860; }
.cupid-modal .cupid-mood p { font-size: 10px; line-height: 1.3; margin: 5px 0 0; display: block; text-align: center; white-space: nowrap; }
.cupid-mood strong { color: #173c49; font-size: 14px; font-weight: 800; }
.cupid-footer { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
.cupid-footer .btn { flex: 1; }
.cupid-modal .btn { min-width: 0; white-space: normal; overflow-wrap: anywhere; }
.cupid-panel-actions { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 10px; }
.cupid-panel-actions .btn { flex: 1 1 82px; padding: 9px 8px; font-size: 12px; line-height: 1.4; }
.cupid-diagnosis { display: grid; }
.cupid-diagnosis-row { background: transparent; color: inherit; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); align-items: center; gap: 6px; width: 100%; padding: 8px 12px; text-align: left; border-bottom: 1px solid #dce5d6; font-size: 12px; line-height: 1.45; }
.cupid-diagnosis-row:disabled { opacity: 1; }
.cupid-diagnosis-row:not(:disabled):hover { background: #edf5e4; }
.cupid-evaluation { display: flex; gap: 5px; align-items: center; font-weight: 650; }
.cupid-evaluation > span { font-size: 21px; }
.evaluation-1 { color: #b44d53; }
.evaluation-2 { color: #536eab; }
.evaluation-3 { color: #417d61; }
.evaluation-4 { color: #52762a; }
.evaluation-5 { color: #9c771f; }
.cupid-evaluation-large { padding: 16px 6px; text-align: center; }
.cupid-evaluation-large > span { display: block; font-size: 46px; line-height: 1.1; }
.cupid-evaluation-large strong { display: block; font-size: 17px; margin-top: 8px; }
.cupid-info-button { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; padding: 9px 3px; border-bottom: 1px solid #dce5d6; text-align: left; color: inherit; background: transparent; font-size: 11px; }
.cupid-info-button > strong { font-size: 13px; line-height: 1.4; overflow-wrap: anywhere; font-weight: 600; }
.cupid-info-button:not(:disabled):hover { background: #edf5e4; }
.cupid-info-button:disabled { opacity: .8; }
.cupid-info-list { margin: 0; }
.cupid-info-line { padding: 10px 2px; border-bottom: 1px solid #dce5d6; }
.cupid-info-line dt { font-size: 11px; color: #688079; }
.cupid-info-line dd { margin: 4px 0 0; font-size: 14px; line-height: 1.45; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.cupid-budget-total { border-bottom: 0; border-top: 2px solid #acbd9e; margin-top: -1px; }
.cupid-budget-total dd { font-weight: 750; }
.cupid-shell .is-negative, .cupid-rank-next dd { color: #b65751; }
.cupid-feature-value { text-align: center; font-weight: 700; overflow-wrap: anywhere; }
.cupid-modal .cupid-count { font-size: 10px; color: #72857d; line-height: 1.4; margin: 10px 1px 4px; }
.cupid-history-filters { display: flex; gap: 5px; overflow-x: auto; padding: 3px 3px 8px; max-width: 100%; overscroll-behavior-x: contain; scrollbar-width: thin; }
.cupid-history-filter { flex: 0 0 auto; width: 52px; min-height: 52px; display: flex; flex-direction: column; gap: 3px; justify-content: center; align-items: center; padding: 5px 3px; border: 1px solid #cad9be; border-radius: 6px; background: #f5f7ea; color: inherit; font-size: 10px; }
.cupid-history-filter:first-child { width: 57px; }
.cupid-history-filter img { width: 27px; height: 30px; image-rendering: pixelated; object-fit: contain; }
.cupid-history-memory { font-size: 24px; line-height: 30px; color: #83966c; }
.cupid-history-filter span { max-width: 100%; overflow-wrap: anywhere; }
.cupid-history-filter.is-selected, .cupid-name-tab.is-selected { background: #e4efd1; border-color: #829b63; box-shadow: inset 0 0 0 1px #a5bb8b; }
.cupid-history-row { display: flex; gap: 7px; align-items: center; border-top: 1px solid #dce5d6; padding: 9px 0; }
.cupid-history-row > div { flex: 1; min-width: 0; }
.cupid-modal .cupid-history-row p { font-size: 10px; color: #72857d; margin: 0 0 4px; line-height: 1.5; overflow-wrap: anywhere; }
.cupid-history-row strong { display: block; font-size: 12px; font-weight: 650; line-height: 1.5; overflow-wrap: anywhere; }
.cupid-history-row .btn { flex: 0 0 48px; padding: 8px 3px; font-size: 10px; line-height: 1.5; }
.cupid-history-row.is-important { border-left: 3px solid #aa6a1c; padding-left: 7px; padding-right: 5px; background: #fff5dd; }
.cupid-history-badges { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 5px; }
.cupid-history-badge { display: inline-block; max-width: 100%; padding: 1px 5px; border: 1px solid #cbd6c2; border-radius: 4px; background: #f5f7ed; color: #566956; font-size: 9px; line-height: 1.5; overflow-wrap: anywhere; }
.cupid-history-badge.is-important { border-color: #bd8a43; background: #ffe8b7; color: #714411; font-weight: 750; }
.cupid-modal .cupid-empty { margin: 18px 0; text-align: center; font-size: 12px; }
.cupid-delegate-back { margin: 0 0 12px; }
.cupid-modal .cupid-setting-note { color: #76867a; font-size: 10px; line-height: 1.6; margin: 3px 0 11px; }
.cupid-name-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
.cupid-name-tab { background: #f5f7ea; border: 1px solid #cad9be; border-radius: 6px; color: inherit; font-size: 12px; padding: 8px 3px; }
.cupid-name-entry { display: flex; gap: 7px; align-items: center; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid #dce5d6; font-size: 12px; }
.cupid-name-entry > span { min-width: 0; overflow-wrap: anywhere; }
.cupid-name-entry .btn { flex: 0 0 auto; font-size: 10px; padding: 5px 6px; }
.cupid-form-error { color: #b65751; }
@media (max-width: 340px) {
  .cupid-overlay { padding: 8px; }
  .cupid-shell { padding: 9px; }
  .cupid-stage { grid-template-columns: 39px minmax(0, 1fr); gap: 5px; }
  .cupid-guide img { width: 46px; height: 46px; }
  .cupid-panel { padding: 7px; }
  .cupid-menu-row { font-size: 13px; padding: 7px 5px; min-height: 34px; }
  .cupid-summary strong { font-size: 16px; }
  .cupid-modal .cupid-speech p { font-size: 12px; }
  .cupid-diagnosis-row { font-size: 11px; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 3px; padding-left: 8px; padding-right: 8px; }
  .cupid-evaluation { gap: 3px; }
  .cupid-evaluation > span { font-size: 18px; }
  .cupid-speech::before { left: 15px; }
  .cupid-info-line dd { font-size: 13px; }
}
@media (prefers-reduced-motion: reduce) { .cupid-guide img { animation: none; } }
/* The generation sheet is a single compact overview, including its complete
 * advice, mood and navigation. Other Cupid pages keep their existing layout. */
.cupid-overlay:has([data-cupid-view="generation-info"]) { padding: 8px; }
.cupid-modal:has([data-cupid-view="generation-info"]) { max-height: calc(100dvh - 16px); }
.cupid-modal:has([data-cupid-view="generation-info"]) .modal-header { padding: 7px 12px; }
.cupid-modal:has([data-cupid-view="generation-info"]) .modal-header h2 { font-size: 16px; }
[data-cupid-view="generation-info"] { padding: 9px; }
[data-cupid-view="generation-info"] .cupid-summary { padding: 6px 9px; margin-bottom: 8px; }
[data-cupid-view="generation-info"] .cupid-summary strong { font-size: 15px; }
[data-cupid-view="generation-info"] .cupid-summary p { margin-top: 2px; font-size: 11px; }
[data-cupid-view="generation-info"] .cupid-stage { grid-template-columns: 49px minmax(0, 1fr); gap: 7px; }
[data-cupid-view="generation-info"] .cupid-guide img { width: 58px; height: 58px; }
[data-cupid-view="generation-info"] .cupid-panel { padding: 6px; }
[data-cupid-view="generation-info"] .cupid-info-button { grid-template-columns: minmax(0, .95fr) minmax(0, 1.15fr); gap: 7px; align-items: center; min-height: 44px; padding: 5px 12px; }
[data-cupid-view="generation-info"] .cupid-info-button > span { color: #667c73; font-size: 11px; line-height: 1.35; overflow-wrap: anywhere; }
[data-cupid-view="generation-info"] .cupid-info-button > strong { color: #173c49; font-size: 16px; line-height: 1.35; font-weight: 800; text-align: right; }
[data-cupid-view="generation-info"] .cupid-info-button.is-negative > strong { color: #ae383c; }
[data-cupid-view="generation-info"] .cupid-info-button:disabled { opacity: 1; }
[data-cupid-view="generation-info"] .cupid-panel-actions { margin-top: 6px; }
[data-cupid-view="generation-info"] .cupid-panel-actions .btn { min-height: 44px; padding: 7px 6px; font-size: 12px; }
[data-cupid-view="generation-info"] .cupid-speech { margin: 11px 0 7px; padding: 7px 10px; }
.cupid-modal [data-cupid-view="generation-info"] .cupid-speech p { margin-top: 3px; font-size: 12px; line-height: 1.45; }
[data-cupid-view="generation-info"] .cupid-mood { margin: 7px auto 0; padding: 6px 8px; }
[data-cupid-view="generation-info"] .cupid-footer { margin-top: 7px; }
[data-cupid-view="generation-info"] .cupid-footer .btn { min-height: 44px; padding: 7px 8px; }
@media (max-height: 650px) {
  [data-cupid-view="generation-info"] .cupid-summary { padding-top: 5px; padding-bottom: 5px; margin-bottom: 6px; }
  [data-cupid-view="generation-info"] .cupid-info-button { min-height: 36px; padding-top: 4px; padding-bottom: 4px; }
  [data-cupid-view="generation-info"] .cupid-info-button > strong { font-size: 15px; line-height: 1.3; }
  [data-cupid-view="generation-info"] .cupid-panel-actions .btn,
  [data-cupid-view="generation-info"] .cupid-footer .btn { min-height: 36px; padding-top: 6px; padding-bottom: 6px; }
  [data-cupid-view="generation-info"] .cupid-speech { margin-top: 10px; margin-bottom: 5px; padding-top: 6px; padding-bottom: 6px; }
  [data-cupid-view="generation-info"] .cupid-mood { margin-top: 5px; padding-top: 5px; padding-bottom: 5px; }
  [data-cupid-view="generation-info"] .cupid-footer { margin-top: 6px; }
}
@media (max-width: 340px) {
  [data-cupid-view="generation-info"] { padding: 8px; }
  [data-cupid-view="generation-info"] .cupid-stage { grid-template-columns: 31px minmax(0, 1fr); gap: 5px; }
  [data-cupid-view="generation-info"] .cupid-guide img { width: 42px; height: 42px; }
  [data-cupid-view="generation-info"] .cupid-info-button { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 5px; padding-left: 8px; padding-right: 8px; }
  [data-cupid-view="generation-info"] .cupid-info-button > span { font-size: 10.5px; }
  [data-cupid-view="generation-info"] .cupid-info-button > strong { font-size: 14px; }
  .cupid-modal [data-cupid-view="generation-info"] .cupid-speech p { font-size: 11.5px; line-height: 1.4; }
  [data-cupid-view="generation-info"] .cupid-speaker { font-size: 10px; }
}
@media (max-height: 600px) {
  [data-cupid-view="generation-info"] { padding-top: 6px; padding-bottom: 6px; }
  [data-cupid-view="generation-info"] .cupid-info-button { padding-top: 2px; padding-bottom: 2px; }
  [data-cupid-view="generation-info"] .cupid-speech { padding-top: 4px; padding-bottom: 4px; }
  [data-cupid-view="generation-info"] .cupid-mood { padding-top: 4px; padding-bottom: 4px; }
}
/* The adjacent diagnosis page also keeps its full touch advice and navigation
 * in a short viewport, without changing the taller-screen presentation. */
@media (max-height: 650px) {
  .cupid-overlay:has([data-cupid-view="generation"]) { padding: 8px; }
  .cupid-modal:has([data-cupid-view="generation"]) { max-height: calc(100dvh - 16px); }
  .cupid-modal:has([data-cupid-view="generation"]) .modal-header { padding: 7px 12px; }
  [data-cupid-view="generation"] { padding: 9px; }
  [data-cupid-view="generation"] .cupid-summary { padding: 5px 9px; margin-bottom: 6px; }
  [data-cupid-view="generation"] .cupid-summary strong { font-size: 15px; }
  [data-cupid-view="generation"] .cupid-summary p { margin-top: 2px; font-size: 11px; }
  [data-cupid-view="generation"] .cupid-panel { padding: 6px; }
  [data-cupid-view="generation"] .cupid-diagnosis-row { min-height: 36px; padding-top: 5px; padding-bottom: 5px; }
  [data-cupid-view="generation"] .cupid-evaluation > span { line-height: 1; }
  [data-cupid-view="generation"] .cupid-panel-actions { margin-top: 6px; }
  [data-cupid-view="generation"] .cupid-panel-actions .btn,
  [data-cupid-view="generation"] .cupid-footer .btn { min-height: 36px; padding: 6px 8px; }
  [data-cupid-view="generation"] .cupid-speech { margin: 11px 0 5px; padding: 6px 10px; }
  .cupid-modal [data-cupid-view="generation"] .cupid-speech p { margin-top: 3px; font-size: 12px; line-height: 1.45; }
  [data-cupid-view="generation"] .cupid-mood { margin: 5px auto 0; padding: 5px 8px; }
  [data-cupid-view="generation"] .cupid-footer { margin-top: 6px; }
}

</style>
  </head>
